# 统一换行符为 LF
# 避免 Windows / macOS / Linux 之间出现"整文件重写"的假 diff
* text=auto eol=lf

# 以下类型不做换行符转换，视为二进制
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.eot   binary
*.pdf   binary
*.zip   binary
*.gz    binary
*.exe   binary
*.dll   binary
*.so    binary
*.dylib binary
*.db    binary
*.mdb   binary
*.pem   binary
*.key   binary

# 锁文件由包管理器生成，不参与 diff 折叠统计
pnpm-lock.yaml -diff
