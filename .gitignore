# ===============================================================
# twilight-blog workspace
# 根级规则：覆盖四个子项目（Go 后端 + 两个本地包 + 前端）
# 子项目内的 .gitignore（如 twilight-blog/.gitignore）继续各自生效
# ===============================================================

# --- 调试产出目录（约定：调试一律用 debug/）-----------------------
# 用户的长期约定：以后调试时默认在 debug 文件夹下调试。
# 工作区根或任一子项目根下的 debug/ 都是调试现场（探针脚本、
# 抓包/响应体转储、临时 sqlite、截图等），一律不入库。
# 用不带前导斜杠的写法，让它在任意层级都生效。
debug/

# --- Node / 前端 -------------------------------------------------
node_modules/
.pnpm-store/
dist/
build/
coverage/
.vite/
*.tsbuildinfo

# --- Python（build.py 等构建脚本） -------------------------------
__pycache__/
*.py[cod]

# --- Go 构建产物 -------------------------------------------------
*.exe
*.dll
*.so
*.dylib
*.test
*.out
/twilight-blog/main

# --- Go 本地缓存（项目内 GOCACHE / GOMODCACHE） ------------------
.gocache/
.modcache/
# GOPATH 也指到工作区内：默认位置的 go mod download 会写 $GOPATH/pkg/sumdb，
# 在受限沙箱下会被拒绝。它只是缓存与工具链副本，不入库。
.gopath/

# --- Go 内嵌资源交换过程中的临时目录 -----------------------------
# build.py 会用 staging/previous 目录做原子替换，不应入库
/twilight-blog/internal/view/web.staging/
/twilight-blog/internal/view/web.previous/

# --- 本地配置与密钥（绝不入库） ----------------------------------
/twilight-blog/settings.json
dkim_private.pem
*.key
.env
.env.local
.env.*.local
# Vite 会读 .env.production / .env.development，上面三条只覆盖了 .local 变体。
# 模板文件必须能入库，故显式放行。
.env.*
!.env.example

# --- SQLite 运行期数据 -------------------------------------------
*.db
*.db-shm
*.db-wal
# 回滚日志：WAL 模式下少见，但 restore 子命令专门要清理 -journal 残留，
# 说明它确实会出现；只覆盖 -wal/-shm 是漏的。
*.db-journal
# 换扩展名或用 sqlite3 CLI 做快照时会出现，*.db 管不到。
*.sqlite
*.sqlite3

# --- 日志 --------------------------------------------------------
*.log
log.txt

# --- 上传媒体 / 检索索引 / 下载的二进制等运行期数据 --------------
/twilight-blog/media/
/twilight-blog/meilisearch-data/
/twilight-blog/dumps/
/twilight-blog/bin/meilisearch-*
/twilight-blog/bin/*.exe
# 站点运行期的 PID 文件（internal/pidfile 写的 blog.pid，落在站点根目录，
# 服务一跑就出现）
*.pid
# backup / restore 子命令的归档产物（单文件 tar.gz）
*.tar.gz
*.tgz
# 根目录下同名的 dumps 目录：上面那条只锚定了 /twilight-blog/ 里的
/dumps/

# --- 编辑器与操作系统 -------------------------------------------
.idea/
.vscode/
.DS_Store
Thumbs.db

# --- 本工作区的本地智能体数据（非项目源码） ----------------------
.workbuddy/

# --- 渗透测试隔离实例与探针产物（非项目源码） --------------------
# 这些目录里含 settings.json 副本（含 password_hash）、SQLite 库、
# Meilisearch 索引数据与测试二进制；绝不能入库。
/.pentest-run*/
**/.pentest/
*.mdb

# --- I2 验收（响应体 diff）的隔离实例与探针 -----------------------
# 含两个不同版本的 main.exe 与它们各自的 blog.db / settings.json 副本。
/.i2/

# --- 第二轮渗透测试的隔离实例与探针产物（非项目源码）--------------
# 与上面的 /.pentest-run*/ 同性质。额外注意：审计类 markdown 报告
# （如 PENTEST-REPORT.md）不在任何忽略规则内，而它们很可能引用真实
# 凭据——把报告摘录进本目录时务必先脱敏。
/.pentest-hunt/

# --- 第三轮渗透测试的隔离实例、探针与证据（非项目源码）------------
# 含沙箱 settings.json / blog.db / media、构建缓存、原始日志证据
# （evidence-log-injection.txt）。汇总报告已脱敏并放在仓库根目录，
# 即 PENTEST-REPORT-ROUND3.md；本目录只作为工作区。
/.pentest-round3/

# --- 探针 / 沙箱实例的运行期数据（build5 等，非源码）--------------
# build5/ 里只有「探针脚本」与「复现程序」是开发产物，其余全是运行期状态：
# instance/ 下有 settings.json、cookies.txt（**含 tw_session 会话令牌**）、
# SQLite 库、上传媒体、Meilisearch 索引与转储的可执行文件。
# 这里刻意**不写整目录规则**，只排运行期产物，免得把 build5/probe5.sh 与
# build5/routerrepro/main.go 这两个开发产物一起排掉。
/build5/instance/
/build5/probe5-results.txt
/build5/*.exe

# --- 提交信息等一次性临时文件 ------------------------------------
.git-commit-msg.tmp

# --- 打包器残留的零字节临时文件 ----------------------------------
# vite/esbuild 在被打断（沙箱 safe-delete 拦截、Ctrl-C）时会留下
# `_tmp_<pid>_<hash>` 的 0 字节文件，散在项目根下。它们不是源码，
# 却会让 git status 一直有噪音、干扰「本轮到底改了什么」的判断。
_tmp_*

# --- AI Agent 工作目录 ---
.claude/
.codebuddy/
.cursor/
.copilot/
.aider*
.gemini/
.trae/
.windsurf/
.continue/
.serena/












