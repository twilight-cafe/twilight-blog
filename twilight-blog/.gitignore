# Build artifacts
*.exe
*.dll
*.so
*.dylib
*.test
*.out
main

# Transient directories used while swapping in freshly built embedded assets
internal/view/web.staging/
internal/view/web.previous/

# Go build cache (when using project-local GOCACHE/GOMODCACHE)
.gocache/
.modcache/

# Local settings and secrets
settings.json
dkim_private.pem

# SQLite runtime data
*.db
*.db-shm
*.db-wal
*.db-journal
*.sqlite
*.sqlite3

# Logs
log.txt
*.log

# Runtime pid file (internal/pidfile writes blog.pid next to settings.json)
*.pid

# backup / restore archives
*.tar.gz
*.tgz

# Uploaded media
/media/
# 端到端测试以 internal/view 为工作目录运行时，media_dir 的默认值 "media"
# 会在这里落一个目录（当前为空）。它是运行期产物，不是源码。
internal/view/media/

# Meilisearch runtime data
/meilisearch-data/

# Downloaded Meilisearch binary cache
/bin/meilisearch-*
/bin/*.exe

# Editor / OS files
.idea/
.vscode/
.DS_Store
Thumbs.db
